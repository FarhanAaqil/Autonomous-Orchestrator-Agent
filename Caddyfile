{$PUBLIC_DOMAIN:localhost} {
    encode gzip zstd
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        -Server
    }
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    reverse_proxy orchestrator_core:8080 {
        health_uri /health
        health_interval 10s
        health_timeout 3s
        flush_interval -1
    }
}
