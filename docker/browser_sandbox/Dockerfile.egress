FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends iptables util-linux && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 1001 sandbox && useradd -u 1001 -g 1001 sandbox
WORKDIR /app
COPY docker/browser_sandbox/requirements-egress.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY docker/browser_sandbox/egress.py /app/
COPY orchestrator_core/__init__.py orchestrator_core/exceptions.py /app/orchestrator_core/
COPY orchestrator_core/tools/read/shared_client.py /app/orchestrator_core/tools/read/
COPY docker/browser_sandbox/entrypoint.sh /app/entrypoint.sh
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod 755 /app/entrypoint.sh
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uvicorn", "egress:app", "--host", "0.0.0.0", "--port", "8889"]
