{
  "name": "toji-shell",
  "productName": "Toji",
  "version": "1.0.0",
  "description": "Toji \u2014 Desktop presence shell for the Orchestrator Agent",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test": "node --test endpoint.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.orchestrator.toji",
    "productName": "Toji",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "endpoint.js",
      "assets/toji-tray.ico",
      "assets/toji-tray.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/toji-tray.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Toji"
    }
  },
  "keywords": [
    "orchestrator",
    "toji",
    "desktop",
    "electron"
  ],
  "author": "Farhan Aaqil",
  "license": "MIT",
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "dependencies": {}
}
